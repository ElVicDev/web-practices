{
    "manifest_version": 1,
    "version": "1.0",
    "name": "Leads Tracker",
    "short_name": "Leads Tracker",
    "description": "This app helps you to save your leads' URLs!",
    "author": "elvicdev",
    "icons":
        [
            {
                "src":"images/android-chrome-192x192.png",
                "sizes":"192x192",
                "type":"image/png"
            },
            { 
                "src":"images/android-chrome-192x192.png",
                "sizes":"512x512",
                "type":"image/png"
            }
        ],
    "theme_color": "#F24F3F",
    "background_color": "#f5fffa",
    "display": "standalone"
}